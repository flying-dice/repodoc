{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out",
      "!**/node_modules",
      "!**/.vscode-test",
      "!**/media/mermaid.min.js",
      "!**/*.vsix",
      "!.claude",
      "!.agents",
      "!.codex",
      "!VS Code Trello Extension",
      "!.playwright-mcp",
      "!boards",
      "!decisions",
      "!features"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off"
      },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "off",
        "useConst": "error",
        "useImportType": "error"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/media/*.js"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off",
            "useOptionalChain": "off"
          },
          "correctness": {
            "noInnerDeclarations": "off"
          },
          "style": {
            "noParameterAssign": "off",
            "useConst": "off",
            "useTemplate": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off",
            "noGlobalIsFinite": "off",
            "noGlobalIsNan": "off",
            "noPrototypeBuiltins": "off",
            "noRedundantUseStrict": "off",
            "noVar": "off"
          }
        }
      }
    }
  ]
}
