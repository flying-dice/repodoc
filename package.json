{
  "name": "@flying-dice/repodoc",
  "version": "0.9.0",
  "private": true,
  "description": "Task boards, decision records, and documentation stored as plain files in your repository — a VS Code extension and a CLI over one core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/flying-dice/repodoc"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "repodoc": "./packages/cli/src/bin.ts"
  },
  "files": [
    "packages/cli/src",
    "packages/core/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "check-types": "bun run --filter '*' check-types",
    "lint": "eslint packages",
    "test": "bun test packages/core packages/cli packages/vscode/test/unit",
    "test:e2e": "bun run --cwd packages/vscode test",
    "compile": "bun run --cwd packages/vscode compile",
    "watch": "bun run --cwd packages/vscode watch",
    "vsix": "bun run --cwd packages/vscode package && bun run --cwd packages/vscode vsix",
    "repodoc": "bun packages/cli/src/bin.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  }
}
